{
  "name": "mcode",
  "productName": "MCode",
  "desktopName": "mcode.desktop",
  "version": "1.0.0",
  "description": "A keyboard-first, command-palette-driven AI coding agent.",
  "author": "MCode",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/soundfont.mjs --optional",
    "dev": "electron-vite dev",
    "soundfont": "node scripts/soundfont.mjs",
    "models-snapshot": "node scripts/models-snapshot.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs --win",
    "package:mac": "node scripts/package.mjs --mac",
    "package:linux": "node scripts/package.mjs --linux",
    "smoke": "esbuild src/server/tool/search-worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/search-worker.mjs --packages=external && esbuild scripts/smoke.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/smoke.mjs --alias:@shared=./src/shared --packages=external && node out/smoke.mjs",
    "icons": "esbuild scripts/gen-provider-icons.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/gen-icons.mjs --packages=external && node out/gen-icons.mjs",
    "themecheck": "esbuild scripts/theme-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/theme-check.mjs --packages=external && node out/theme-check.mjs",
    "mcpcheck": "esbuild scripts/mcp-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/mcp-check.mjs --packages=external && node out/mcp-check.mjs",
    "i18ncheck": "esbuild scripts/i18n-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/i18n-check.mjs --packages=external && node out/i18n-check.mjs",
    "mdcheck": "esbuild scripts/markdown-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/markdown-check.mjs --packages=external && node out/markdown-check.mjs",
    "sessioncheck": "esbuild scripts/session-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/session-check.mjs --packages=external && node out/session-check.mjs",
    "snapshotcheck": "esbuild scripts/snapshot-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --alias:@server=./src/server --outfile=out/snapshot-check.mjs --packages=external && node out/snapshot-check.mjs",
    "sandboxcheck": "esbuild scripts/sandbox-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/sandbox-check.mjs --packages=external && node out/sandbox-check.mjs",
    "remotecheck": "esbuild scripts/remote-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/remote-check.mjs --packages=external --loader:.html=text --log-level=error && node out/remote-check.mjs",
    "remote": "esbuild scripts/remote-server.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/remote-server.mjs --packages=external --loader:.html=text --log-level=error && node out/remote-server.mjs",
    "toolcheck": "esbuild scripts/tool-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/tool-check.mjs --packages=external && node out/tool-check.mjs",
    "wiringcheck": "esbuild scripts/wiring-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/wiring-check.mjs --packages=external && node out/wiring-check.mjs",
    "promptcheck": "esbuild scripts/prompt-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/prompt-check.mjs --packages=external && node out/prompt-check.mjs",
    "shellcheck": "esbuild scripts/shell-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/shell-check.mjs --packages=external && node out/shell-check.mjs",
    "providercheck": "esbuild scripts/provider-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=out/provider-check.mjs --packages=external && node out/provider-check.mjs",
    "pathscheck": "esbuild scripts/paths-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/paths-check.mjs --packages=external && node out/paths-check.mjs",
    "gencheck": "node scripts/gen-cockpit.mjs --check",
    "prebuild": "npm run gencheck",
    "androidtheme": "esbuild scripts/android-theme-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/android-theme-check.mjs --packages=external && node out/android-theme-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@mixmark-io/domino": "2.2.0",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.2.3",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "5.0.6",
    "@types/ws": "^8.5.13",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/presets": "0.25.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "abcjs": "6.7.0",
    "docx-preview": "0.3.7",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "electron": "41.10.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "exceljs": "4.4.0",
    "js-synthesizer": "1.13.0",
    "jszip": "3.10.1",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "pdfjs-dist": "5.4.296",
    "pinia": "^3.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "simple-icons": "^16.28.0",
    "turndown": "7.2.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
