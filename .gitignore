.workbuddy/*.txt
.workbuddy/*.py
.workbuddy/*.cjs
.workbuddy/*.mjs
.workbuddy/*.js
.workbuddy/*.log
.workbuddy/*.json

# Stray byproducts at the repository root: a sqlite scratch file and two one-off
# drawings made while testing the artifact viewer. Neither belongs to the app.
.workdb
