# Local agent tooling: its own settings and worktrees, not part of the product.
.claude/

# The agent's own scratch space: debug scripts, screen captures, bytecode and
# extracted sources. None of it is product. The written records under
# .workbuddy/memory and its status notes stay tracked - they are the history of
# what was measured and why - so the directory is excluded by kind, not wholesale.
.workbuddy/*.png
.workbuddy/shots/
.workbuddy/__pycache__/
.workbuddy/tmp/
.workbuddy/*.pyc
.workbuddy/*.kt
.workbuddy-ai/
